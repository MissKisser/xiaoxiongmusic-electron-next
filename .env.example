# =====================================================
# 小熊音乐 - 环境变量示例
# 复制为 .env 后按需修改（.env 不会进入版本控制）
# =====================================================

# 自有后端（授权校验 / 后台管理）基地址
# 留空或不配置时回落到默认地址 https://music.viaxv.cn
VITE_AUTH_SERVER_URL=https://music.viaxv.cn

# 内嵌桥接服务端口（默认 25884）
VITE_SERVER_PORT=25884
